# Copy to .env and fill in. The chat agent (sunshine_scraper/agent) loads .env
# with python-dotenv; other entry points read these from the terminal or
# deployment environment. .env is gitignored: never commit real secrets.
SUNSHINE_DATABASE_URL=postgresql://sunshine:CHANGE_ME@localhost:5432/sunshine
# Optional: a DEDICATED test database for the real-PostgreSQL tests.
# Leave it unset and those tests are skipped; the rest still run offline.
SUNSHINE_TEST_DATABASE_URL=postgresql://sunshine:CHANGE_ME@localhost:5432/sunshine_test
# Groq API key for the chat agent (https://console.groq.com/keys). Server-only:
# it is never sent to the browser.
GROQ_API_KEY=
